# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=paste-a-long-random-string-here

# The owner account is created from these on startup
OWNER_EMAIL=owner@yourrestaurant.com
OWNER_PASSWORD=choose-a-long-password
OWNER_PHONE=08000000000

# Paystack: use the sk_test_ key until you are ready for real money
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Where Paystack sends the customer after paying. Use the site root; the site confirms the payment on load.
PAYSTACK_CALLBACK_URL=http://127.0.0.1:8000/

# Optional (defaults to a local SQLite file). Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/restaurant
# DATABASE_URL=sqlite:///./restaurant.db
